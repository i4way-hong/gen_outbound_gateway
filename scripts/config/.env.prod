# production environment (현재 프로젝트 기본 적용값 기준)

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# logback 설정 경로 (외부 설정 사용 시)
LOGBACK_CONFIG_PATH=./scripts/config/logback-spring.xml
# 로그 파일 저장 경로
LOG_DIR=./logs

DB_URL=jdbc:sqlserver://172.168.30.61:1433;databaseName=RND_TEST;encrypt=true;trustServerCertificate=true
DB_USERNAME=RND_USER
DB_PASSWORD=RND_USER

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

AUTH_ENABLED=true
JWT_ENABLED=true
ALLOW_INSECURE=false
ALLOW_SWAGGER=true
ALLOW_ADMIN_UI=false
JWT_ISSUER=gen-outbound-gateway
JWT_SECRET=CHANGE_ME_32_BYTE_SECRET_FOR_PROD
JWT_ACCESS_TOKEN_MINUTES=1
JWT_REFRESH_TOKEN_DAYS=1

CCC_SERVICE_ENC_ENABLED=false
CCC_SERVICE_ENC_KEY=12345678901234567890123456789012
CCC_SERVICE_ENC_IV=1234567890123456

OUTBOUND_URI=tcp://172.168.20.233:2130
OUTBOUND_URI_B=tcp://172.168.20.233:2130
OUTBOUND_CLIENT_NAME=default
OUTBOUND_CLIENT_PASSWORD=
OUTBOUND_APP_NAME=ocserver
OUTBOUND_APP_PASSWORD=

GENESYS_CFG_ENDPOINT_P=Cfg_EP_P
GENESYS_CFG_IP_P=172.168.20.233
GENESYS_CFG_PORT_P=2020
GENESYS_CFG_ENDPOINT_B=Cfg_EP_B
GENESYS_CFG_IP_B=172.168.20.233
GENESYS_CFG_PORT_B=2020
GENESYS_CFG_CLIENT_NAME_B=default
GENESYS_CFG_USERNAME=default
GENESYS_CFG_PASSWORD=password
GENESYS_TENANT_DBID=1
GENESYS_SWITCH_DBID_PRIMARY=101
GENESYS_SWITCH_DBID_SECONDARY=101
GENESYS_CHARSET=MS949
GENESYS_CFG_ADDP_ENABLED=true
GENESYS_CFG_ADDP_CLIENT_TIMEOUT=5
GENESYS_CFG_ADDP_SERVER_TIMEOUT=5
GENESYS_CFG_HEALTH_CHECK_INTERVAL_MS=30000
