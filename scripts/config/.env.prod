# production environment (현재 프로젝트 기본 적용값 기준)

SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# logback 설정 경로 (외부 설정 사용 시)
LOGBACK_CONFIG_PATH=./scripts/config/logback-spring.xml
# 로그 파일 저장 경로
LOG_DIR=./logs

DB_URL=jdbc:sqlserver://172.168.30.61:1433;databaseName=RND_TEST;encrypt=true;trustServerCertificate=true
DB_USERNAME=RND_USER
DB_PASSWORD=RND_USER

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

AUTH_ENABLED=true
JWT_ENABLED=true
ALLOW_INSECURE=false
ALLOW_SWAGGER=true
ALLOW_CRYPTO_TEST=true
ALLOW_ADMIN_UI=false
JWT_ISSUER=gen-outbound-gateway
JWT_SECRET=CHANGE_ME_32_BYTE_SECRET_FOR_PROD
JWT_ACCESS_TOKEN_MINUTES=1
JWT_REFRESH_TOKEN_DAYS=1

CCC_SERVICE_ENC_ENABLED=false
